# PostgreSQL bağlantısı
DATABASE_URL="postgresql://postgres:tahsilo_dev@localhost:5432/tahsilo?schema=public"
# Test veritabanı (tenant izolasyon testleri bunu kullanır)
TEST_DATABASE_URL="postgresql://postgres:tahsilo_dev@localhost:5432/tahsilo_test?schema=public"

PORT=4000
# Web uygulamasının adresi (ödeme linkleri ve dönüş adresleri için)
WEB_URL="http://localhost:3000"
# API'nin dışarıdan erişilen adresi (mock sağlayıcı webhook'u buraya gelir)
API_URL="http://localhost:4000"

# En az 32 karakterlik rastgele değerler kullanın
JWT_SECRET="change-me-to-a-long-random-string-0123456789"
# 32 bayt, base64 (openssl rand -base64 32) — sırlar ve dosyalar bu anahtarla şifrelenir
ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# Şifreli dosya deposu
STORAGE_DIR="./storage"

# Mock sanal POS webhook imza sırrı
MOCKPOS_WEBHOOK_SECRET="mockpos-dev-secret"
