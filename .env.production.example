# Yalnızca Coolify DIŞINDA, düz "docker compose" ile kurulum için.
# Coolify kullanıyorsanız bu dosyaya gerek yok: SERVICE_* değerlerini Coolify kendisi üretir.
# Kullanım: cp .env.production.example .env  →  doldurun  →  docker compose up -d --build

# Kullanıcıların tarayıcıda açtığı adres (HTTPS)
SERVICE_FQDN_WEB=https://tahsilo.example.com

# Rastgele değerler: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SERVICE_PASSWORD_POSTGRES=
SERVICE_PASSWORD_64_JWT=
# DİKKAT: Bu değer kaybolursa şifreli belgeler ve bağlantı sırları açılamaz; güvenli bir yerde ayrıca saklayın.
SERVICE_PASSWORD_64_ENCRYPTION=
SERVICE_PASSWORD_MOCKPOS=

# İsteğe bağlı: e-posta bildirimleri (boşsa e-postalar gönderilmez)
SMTP_URL=
MAIL_FROM=Tahsilo <bildirim@tahsilo.example.com>
BANK_SYNC_INTERVAL_MINUTES=60
